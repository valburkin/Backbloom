// Generated config file

// enable emmbeded web resources
#cmakedefine USE_EMBEDDED_WEB_RESOURCES

// enable shared lib loading
#cmakedefine USE_SHARED_LIBS

// the build id string
#define OVERGLOW_BUILD_ID "${OVERGLOW_BUILD_ID}"

// product support/documentation page shown by the UIs and installers (empty: no link)
#define OVERGLOW_SUPPORT_URL "${OVERGLOW_SUPPORT_URL}"

#define OVERGLOW_VERSION_MAJOR "${OVERGLOW_VERSION_MAJOR}"
#define OVERGLOW_VERSION_MINOR "${OVERGLOW_VERSION_MINOR}"
#define OVERGLOW_VERSION_PATCH "${OVERGLOW_VERSION_PATCH}"
#define OVERGLOW_VERSION "${OVERGLOW_VERSION}"

#define OVERGLOW_JSON_VERSION "1.0.0"
