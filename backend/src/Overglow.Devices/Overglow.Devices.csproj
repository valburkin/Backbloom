<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>LED device lifecycle and drivers (network, serial, HID, debug).</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Overglow.Core\Overglow.Core.csproj" />
    <ProjectReference Include="..\Overglow.Discovery\Overglow.Discovery.csproj" />
    <ProjectReference Include="..\Overglow.Mqtt\Overglow.Mqtt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="HidSharp" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schemas\*.json" LogicalName="Overglow.Devices.Schemas.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Overglow.Devices.Tests" />
  </ItemGroup>
</Project>
