{
  "type": "object",
  "title": "Game mode",
  "required": true,
  "comment": "What Game mode changes (new in Backbloom): its values replace the matching ones of smoothing, color.channelAdjustment[0] and systemGrabber while Game mode is on, without saving them there (Engine/GameTuning). Defaults: the Intense preset of the UI (ui/src/settings/intensity.ts) and its spring (springFor(150)), 60 fps.",
  "properties": {
    "time_ms": {
      "type": "integer",
      "minimum": 25,
      "maximum": 5000,
      "default": 150,
      "required": true
    },
    "stiffness": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "default": 817,
      "required": true
    },
    "damping": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "default": 61,
      "required": true
    },
    "saturationGain": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10.0,
      "default": 1.5,
      "required": true
    },
    "luminanceGain": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10.0,
      "default": 1.2,
      "required": true
    },
    "fps": {
      "type": "integer",
      "minimum": 5,
      "maximum": 120,
      "default": 60,
      "required": true
    }
  },
  "additionalProperties": false
}
