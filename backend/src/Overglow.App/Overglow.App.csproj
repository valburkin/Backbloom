<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Overglow host: composition root, configuration and process lifetime.</Description>
    <OutputType>Exe</OutputType>
    <AssemblyName>overglow</AssemblyName>
    <RootNamespace>Overglow.App</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Overglow.Audio.Windows\Overglow.Audio.Windows.csproj" />
    <ProjectReference Include="..\Overglow.Capture.Windows\Overglow.Capture.Windows.csproj" />
    <ProjectReference Include="..\Overglow.Platform.Windows\Overglow.Platform.Windows.csproj" />
    <ProjectReference Include="..\Overglow.Server\Overglow.Server.csproj" />
  </ItemGroup>
</Project>
