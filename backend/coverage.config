<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage for the product assemblies (Microsoft.Testing.Extensions.CodeCoverage: dotnet test with
  coverage settings; the format of the Code Coverage data collector's configuration).
  Usage: see the Coverage section of docs/development.md.
-->
<Configuration>
  <IncludeTestAssembly>False</IncludeTestAssembly>
  <CodeCoverage>
    <SkipAutoProperties>True</SkipAutoProperties>
    <ModulePaths>
      <Include>
        <!-- backbloom.dll (the app) and Backbloom.*.dll -->
        <ModulePath>.*[\/]backbloom(\.[^\/]+)?\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*\.Tests\.dll$</ModulePath>
        <ModulePath>.*TerraFX.*</ModulePath>
      </Exclude>
    </ModulePaths>
    <Attributes>
      <Exclude>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Runtime\.CompilerServices\.CompilerGeneratedAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.DebuggerNonUserCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <Sources>
      <Exclude>
        <!-- Source generator output: [LoggerMessage], [GeneratedRegex], JSON contexts, [LibraryImport] -->
        <Source>.*\.g\.cs$</Source>
        <Source>.*[\/]obj[\/].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
