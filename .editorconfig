root = true

# UTF-8, LF line endings and a final newline everywhere
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Web UI (ui/)
[*.{ts,tsx,js,mjs,css,html}]
indent_style = space
indent_size = 2

[*.{json,yml,yaml,webmanifest}]
indent_style = space
indent_size = 2

# Packaging scripts
[*.ps1]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# backend/.editorconfig adds the C# and MSBuild rules
