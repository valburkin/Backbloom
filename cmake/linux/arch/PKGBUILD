pkgname=Overglow
pkgver={VERSION}
pkgrel=1
pkgdesc="Overglow ambient lighting for TVs and monitors."
url="${OVERGLOW_SUPPORT_URL:-}"
license=('MIT')
arch=('x86_64')
install=INSTALL
depends=('xz' 'dbus' 'glibc>={GLIBC_VERSION}') #<depends>
optdepends=('gtk3')
# not needed fot Github Action
# md5sums=('SKIP')

prepare() {
    sed -i 's|BUILD_WITH_INSTALL_RPATH FALSE|BUILD_WITH_INSTALL_RPATH TRUE|' ../sources/app/CMakeLists.txt
}

build() {
    export LDFLAGS=${LDFLAGS/-Wl,-z,pack-relative-relocs/}
    cmake -B build -S .. \
        -DCMAKE_BUILD_TYPE='None' \
        -DCMAKE_INSTALL_PREFIX='/usr' \
        -Wno-dev {BUILD_OPTION}
    cmake --build build
    mkdir -p build/lib/overglow
    cp -P build/lib/*.so* build/lib/overglow/ 2>/dev/null || true
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    rm -rf $pkgdir/usr/cmake
    rm -rf $pkgdir/usr/include
    find "$pkgdir/usr/lib" -maxdepth 1 -mindepth 1 ! -name "overglow" ! -name "systemd" -exec rm -rf {} +
}
