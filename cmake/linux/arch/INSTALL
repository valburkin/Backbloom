pre_install() {
    echo "Preparing to install Overglow..."
    FOUND_USR="${SUDO_USER:-${LOGNAME:-$(id -u -n)}}"
    if pgrep overglow > /dev/null 2>&1; then
        if grep -m1 systemd /proc/1/comm > /dev/null; then
            systemctl stop overglow"@${FOUND_USR}" 2> /dev/null
        fi
    fi
    killall overglow 2> /dev/null
}

pre_upgrade() {
    pre_install
}

post_install() {
    echo "Finalizing Overglow setup"

    NET_IP=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{print $7}' | head -n 1)
    [ -z "$NET_IP" ] && NET_IP=$(hostname -I 2>/dev/null | cut -d " " -f1)
    [ -z "$NET_IP" ] && NET_IP="127.0.0.1"
    
    FOUND_USR="${SUDO_USER:-${LOGNAME:-$(id -u -n)}}"

    ENABLE_SERVICE=0
    STARTUP_MSG="Service is NOT enabled by default for GUI OS"
    REBOOTMESSAGE=""
    start_msg=""

    if grep -m1 systemd /proc/1/comm > /dev/null; then
        if [ -z "${DISPLAY}" ]; then
            echo "Init daemon: systemd (service is enabled by default for console systems)"
            ENABLE_SERVICE=1
            STARTUP_MSG="Overglow is installed as a service and starts automatically"
        else
            echo "Init daemon: GUI detected (service is NOT enabled by default)"
            ENABLE_SERVICE=0
        fi

        systemctl daemon-reload

        if [ $ENABLE_SERVICE -eq 1 ]; then
            systemctl enable --now "overglow@${FOUND_USR}.service" 2>/dev/null || true
            start_msg="systemctl start overglow for user ${FOUND_USR}"
        fi
    else
        echo "Warning: No systemd detected. Service management will be manual."
    fi

    echo "${start_msg}"

    printf "\n +-----------------------------------------------------------------------+"
    printf "\n |                  \033[32;1mOverglow has been installed/updated!\033[0m                 |"
    printf "\n +-----------------------------------------------------------------------+"
    printf "\n |  For configuration, visit with your browser: \033[37;1m%13s:%s\033[0m       |" "$NET_IP" "8090"
    printf "\n |  If already used by another service try: \033[37;1m%13s:%s\033[0m           |" "$NET_IP" "8091"
    printf "\n |  Start the service: \033[37;1msudo systemctl start overglow@%-12s\033[0m        |" "$FOUND_USR"
    printf "\n |  Stop the service: \033[37;1msudo systemctl stop overglow@%-12s\033[0m          |" "$FOUND_USR"
    printf "\n |  Troubleshooting? Run Overglow manually: \033[37;1m/usr/bin/overglow\033[0m            |"
    printf "\n +-----------------------------------------------------------------------+"
    case "$STARTUP_MSG" in 
      *"Overglow is installed as a service"*)
        printf "\n |  \033[32;1m%-67s\033[0m  |" "$STARTUP_MSG";;
      *) printf "\n |  \033[31;1m%-67s\033[0m  |" "$STARTUP_MSG"
    esac
    [ -z "$REBOOTMESSAGE" ] || printf "\n |  \033[31;1m%-67s\033[0m  |" "$REBOOTMESSAGE"
    printf "\n +-----------------------------------------------------------------------+\n"
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo "Preparing to uninstall Overglow"
    FOUND_USR="${SUDO_USER:-${LOGNAME:-$(id -u -n)}}"
    OVERGLOW_RUNNING=false
    pgrep overglow > /dev/null 2>&1 && OVERGLOW_RUNNING=true

    if grep -m1 systemd /proc/1/comm > /dev/null; then
        $OVERGLOW_RUNNING && systemctl stop overglow"@${FOUND_USR}" 2> /dev/null
        systemctl -q disable overglow"@${FOUND_USR}" 2>/dev/null
        systemctl daemon-reload
    fi
    killall overglow 2> /dev/null
}
