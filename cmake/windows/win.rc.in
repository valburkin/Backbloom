IDI_ICON1 ICON DISCARDABLE "${WIN_RC_ICON_PATH}"
1 VERSIONINFO
 FILEVERSION ${OVERGLOW_VERSION_MAJOR},${OVERGLOW_VERSION_MINOR},${OVERGLOW_VERSION_PATCH},0
 PRODUCTVERSION ${OVERGLOW_VERSION_MAJOR},${OVERGLOW_VERSION_MINOR},${OVERGLOW_VERSION_PATCH},0
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Overglow"
            VALUE "Comments", "Overglow ambient lighting"
            VALUE "FileDescription", "Overglow Ambient Lighting"
            VALUE "FileVersion", "${OVERGLOW_VERSION}"
            VALUE "InternalName", "Overglow"
            VALUE "LegalCopyright", "MIT"
            VALUE "OriginalFilename", "${BINARY_NAME}"
            VALUE "ProductName", "Overglow Ambient Lighting"
            VALUE "ProductVersion", "${OVERGLOW_VERSION}"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
